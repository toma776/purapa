{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run migrate",
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index"}
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "src/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {"path": "/api/manage/cron/tick", "schedule": "0 * * * *"}
  ]
}
